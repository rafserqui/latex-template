% Add spacing after Beamer has parsed list options and selected the list font.
\makeatletter
\expandafter\patchcmd\csname\string\itemize\endcsname
  {\beamer@cramped}
  {\beamer@cramped\addtolength{\itemsep}{0.8\baselineskip}}
  {}{\PackageError{clean_style_beamer}{Cannot patch itemize spacing}{Check the Beamer list implementation.}}
\patchcmd{\beamer@enum@}
  {\beamer@cramped}
  {\beamer@cramped\addtolength{\itemsep}{0.8\baselineskip}}
  {}{\PackageError{clean_style_beamer}{Cannot patch enumerate spacing}{Check the Beamer list implementation.}}
\makeatother

