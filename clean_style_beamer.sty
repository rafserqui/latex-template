\setbeamertemplate{theorems}[numbered]

% Keep example theorem headings blue without changing ordinary example blocks.
\addtobeamertemplate{theorem begin}{\setbeamercolor{block title example}{fg=MainColor}}{}

\makeatletter
    \theoremstyle{plain}
    \@ifundefined{theorem}{%
    \ifbeamer@countsect
      \newtheorem{theorem}{\translate{Theorem}}[section]
    \else
      \newtheorem{theorem}{\translate{Theorem}}
    \fi
    }{}
    \@ifundefined{corollary}{\newtheorem{corollary}{\translate{Corollary}}}{}
    \@ifundefined{fact}{\newtheorem{fact}{\translate{Fact}}}{}
    \@ifundefined{lemma}{\newtheorem{lemma}{\translate{Lemma}}}{}
    \@ifundefined{problem}{\newtheorem{problem}{\translate{Problem}}}{}
    \@ifundefined{solution}{\newtheorem{solution}{\translate{Solution}}}{}

    \theoremstyle{definition}
    \@ifundefined{definition}{\newtheorem{definition}{\translate{Definition}}}{}
    \@ifundefined{definitions}{\newtheorem{definitions}{\translate{Definitions}}}{}

    \theoremstyle{example}
    \@ifundefined{example}{\newtheorem{example}{\translate{Example}}}{}
    \@ifundefined{examples}{\newtheorem{examples}{\translate{Examples}}}{}
    \@ifundefined{exercise}{\newtheorem{exercise}{Exercise}}{}

    \theoremstyle{plain}
    \@ifundefined{assumption}{\newtheorem{assumption}{Assumption}}{}

    \@ifundefined{proposition}{\newtheorem{proposition}{\translate{Proposition}}}{}
    % Compatibility
    \@ifundefined{Beispiel}{\newtheorem{Beispiel}{Beispiel}}{}
    \@ifundefined{Beispiele}{\newtheorem{Beispiele}{Beispiele}}{}
    \theoremstyle{plain}
    \@ifundefined{Loesung}{\newtheorem{Loesung}{L\"osung}}{}
    \@ifundefined{Satz}{\newtheorem{Satz}{Satz}}{}
    \@ifundefined{Folgerung}{\newtheorem{Folgerung}{Folgerung}}{}
    \@ifundefined{Fakt}{\newtheorem{Fakt}{Fakt}}{}
    \@ifundefined{Beweis}{\newenvironment{Beweis}{\begin{proof}[Beweis.]}{\end{proof}}}{}
    \@ifundefined{Lemma}{\newenvironment{Lemma}{\begin{lemma}}{\end{lemma}}}{}
    \@ifundefined{Proof}{\newenvironment{Proof}{\begin{proof}}{\end{proof}}}{}
    \@ifundefined{Theorem}{\newenvironment{Theorem}{\begin{theorem}}{\end{theorem}}}{}
    \@ifundefined{Problem}{\newenvironment{Problem}{\begin{problem}}{\end{problem}}}{}
    \@ifundefined{Corollary}{\newenvironment{Corollary}{\begin{corollary}}{\end{corollary}}}{}
    \@ifundefined{Example}{\newenvironment{Example}{\begin{example}}{\end{example}}}{}
    \@ifundefined{Examples}{\newenvironment{Examples}{\begin{examples}}{\end{examples}}}{}
    \@ifundefined{Definition}{\newenvironment{Definition}{\begin{definition}}{\end{definition}}}{}
\makeatother


% Section styling
\AtBeginSection[]{\frame{\sectionpage}}
\AtBeginSubsection[]{\frame{\subsectionpage}}

\defbeamertemplate{section page}{mine}[1][]{%
  \begin{centering}
    {\usebeamerfont{section name}\usebeamercolor[fg]{section name}#1}
    \vskip1em\par
    \begin{beamercolorbox}[sep=12pt,center]{part title}
      \usebeamerfont{section title}\insertsection\par
    \end{beamercolorbox}
  \end{centering}
}

\defbeamertemplate{subsection page}{mine_sub}[1][]{%
  \begin{centering}
    {\usebeamerfont{subsection name}\usebeamercolor[fg]{subsection name}#1}
    \vskip1em\par
    \begin{beamercolorbox}[sep=12pt,center]{part title}
      \usebeamerfont{subsection title}\insertsubsection\par
    \end{beamercolorbox}
  \end{centering}
}

\setbeamertemplate{section page}[mine]
\setbeamertemplate{subsection page}[mine_sub]

